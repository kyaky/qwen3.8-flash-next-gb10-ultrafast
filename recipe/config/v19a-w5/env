CACHE_MOUNT='$GB10_WORKSPACE/envs/compile-cache'

# P2 stage-1c G2 harness: the ARMED wiring drives per-step K through
# SchedulerOutput.num_spec_tokens_to_schedule; FORCE=oscillate replaces the
# EMA decision with a forced square wave across the candidate ladder for the
# byte-identity probe (3<->4 at this config's MTP=4 / launch_k=4; the gate
# harness rewrites MTP and the mode/force knobs per boot in its scratch copy).
ADAPTIVE_WIDTH_MODE='off'
ADAPTIVE_WIDTH_FORCE=''

# D-011 moe-align stable-sort shim (D-010: the P4 byte-identity gate is
# absolute). The proven tie-flip source is moe_align_block_size's atomicAdd
# arrival-order scatter feeding the moe_wna16 Marlin kernel's k-slice split;
# the shim canonicalizes each expert group's segment ascending by pair id
# inside the captured graph (semantically identical: the per-group pair SET
# is deterministic, only arrival order varied). Image iter7d carries the
# shim; serve.sh passes this through as VLLM_MOE_ALIGN_STABLESORT.
MOE_ALIGN_STABLESORT='1'

# v19a promoted-candidate floor (iter7f): R-028/R-034 determinism fixes on
# the promoted line. MOE_ALIGN_STABLESORT=1 (shim, D-011) + MARLIN_ATOMIC_
# ADD=0 (drafter dense-marlin epilogue off, R-028/R-034) + TRITON_FORCE_
# FIRST_CONFIG=1 (R-029 autotune boot-lottery pin). Static width candidate
# (MTP=4 window-5 for w5 / MTP=3 for w4); ADAPTIVE off.
MOE_ALIGN_STABLESORT='1'
MARLIN_ATOMIC_ADD='0'
TRITON_FORCE_FIRST_CONFIG='1'
